commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

pattern='^(feat|fix|hotfix|chore|refactor|test|docs|style|ci)(\([a-z-]+\))?: SNAP-[0-9]+ [a-z].+'

if ! echo "$commit_msg" | grep -qE "$pattern";
then
echo "❌ Название коммита '$commit_msg' не соответствует шаблону."
echo "\
==========================

ПРИМЕРЫ КОММИТОВ:

feat(auth): SNAP-45 add user registration endpoint
fix: SNAP-12 resolve login error

Типы:
- feat: новая функциональность
- fix: исправление ошибки
- hotfix: срочное исправление
- chore: обслуживание, не влияющие на код приложения
- refactor: рефакторинг без изменения поведения
- test: добавление/изменение тестов
- docs: работа с документацией
- style: изменения в коде, не влияющие на поведение
- ci: настройка CI/CD

Общие соглашения по коммитам:
OEP-51: Conventional Commits
https://open-edx-proposals.readthedocs.io/en/latest/best-practices/oep-0051-bp-conventional-commits.html

Соглашение о коммитах
https://www.conventionalcommits.org/ru/v1.0.0/
==========================
"
  exit 1
fi

echo "✅ Коммит '$commit_msg' соответствует шаблону"
