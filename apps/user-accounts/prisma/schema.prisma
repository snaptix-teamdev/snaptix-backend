// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// При изменении обновить файл libs/contracts/src/enums/oauth-provider.enum
enum OAuthProvider {
  GOOGLE
  YANDEX
  VK
  GITHUB
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], name: "Session")
  deviceId   String   @map("device_id") @db.Uuid
  deviceName String   @map("device_name")
  ip         String?  @db.Inet
  issuedAt   DateTime @map("issued_at") @db.Timestamptz()
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([userId, deviceId])
  @@map("sessions")
}

model User {
  id                String                 @id @default(uuid(7)) @db.Uuid
  email             String                 @unique @map("email")
  username          String                 @unique @map("username")
  passwordHash      String?                @map("password_hash") @db.VarChar()
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz()
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz()
  emailConfirmation UserEmailConfirmation? @relation("UserEmailConfirmation")
  recoveryPassword  UserRecoveryPassword?  @relation("UserRecoveryPassword")
  sessions          Session[]              @relation("Session")
  userProvider      UserProvider[]         @relation("UserProvider")
  profile           UserProfile?           @relation("UserProfile")

  @@map("users")
}

model UserEmailConfirmation {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique @default(uuid(7)) @map("code") @db.Uuid
  isVerified Boolean  @default(false) @map("is_verified") @db.Boolean
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  userId     String   @unique @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], name: "UserEmailConfirmation")

  @@map("user_email_confirmation")
}

model UserRecoveryPassword {
  id                String   @id @default(uuid(7)) @db.Uuid
  code              String   @unique @default(uuid(7)) @map("code") @db.Uuid
  isCodeAlreadyUsed Boolean  @default(false) @map("is_code_already_used") @db.Boolean
  expiresAt         DateTime @map("expires_at") @db.Timestamptz()
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  userId            String   @unique @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], name: "UserRecoveryPassword")

  @@map("user_recovery_password")
}

model UserProfile {
  id        String    @id @default(uuid(7)) @db.Uuid
  firstName String?   @map("first_name")
  lastName  String?   @map("last_name")
  birthDate DateTime? @map("birth_date") @db.Date
  countryId Int       @map("country_id")
  regionId  Int       @map("region_id")
  cityId    Int       @map("city_id")
  aboutMe   String?   @map("about_me")
  avatarUrl String?   @map("avatar_url")

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], name: "UserProfile")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  @@map("user_profile")
}

model UserProvider {
  id                 String        @id @default(uuid(7)) @db.Uuid
  provider           OAuthProvider
  externalProviderId String
  email              String

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], name: "UserProvider")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  @@unique([provider, externalProviderId])
  @@map("user_providers")
}
