# Порт для запуска HTTP приложения. Пример: 9001
PORT=

# Хост и порт для настройки микросервиса в кубернетис
# ДЛЯ ЭТОГО МИКРОСЕРВИСА УКАЗЫВАТЬ ПОРТ ТАКОЙ ЖЕ КАК PORT ВЫШЕ
# https://samurai.it-incubator.io/pc/video-content/watch/cllp3y3qh019ckd13g1ymakvt
MICROSERVICE_USER_ACCOUNTS_HOST=
MICROSERVICE_USER_ACCOUNTS_PORT=

# Разрешенные домены для CORS
# Пример: https://ya.ru,https://google.com
CORS_ALLOWED_ORIGINS=

# Пример: postgresql://<username>:<password>@<hostname>:<port>/<database-name>
POSTGRES_USER_ACCOUNTS_URL=

# Пример: amqp://username:password@localhost:5672
RABBITMQ_URI=

#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION
# Время жизни кода подтверждения почты в минутах, например 60
EMAIL_CONFIRMATION_CODE_TTL_MINUTES=
# Время жизни кода сброса пароля в часах, например 1
PASSWORD_RESET_CODE_TTL_HOURS=
