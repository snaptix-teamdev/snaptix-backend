# Порт для запуска HTTP приложения. Пример: 9001
PORT=

# Пример: amqp://username:password@localhost:5672
RABBITMQ_URI=

#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION

# Email Settings
# example: smtp.mail.ru
MAIL_HOST=
# example: 465
MAIL_PORT=
# example: example@mail.ru
MAIL_USER=
# example: passwordForMail
MAIL_PASS=
# true for production
MAIL_USE_SECURE=
# false for production
MAIL_IGNORE_TLS=

# example: https://example.ru
APP_BASE_URL=
