# Порт для запуска приложения. Пример: 9000
PORT=

# Хост и порт для настройки микросервиса в кубернетис
# https://samurai.it-incubator.io/pc/video-content/watch/cllp3y3qh019ckd13g1ymakvt
MICROSERVICE_USER_ACCOUNTS_PORT=
MICROSERVICE_USER_ACCOUNTS_HOST=

MICROSERVICE_FILES_PORT=
MICROSERVICE_FILES_HOST=

MICROSERVICE_POSTS_PORT=
MICROSERVICE_POSTS_HOST=

MICROSERVICE_GEO_PORT=
MICROSERVICE_GEO_HOST=

# Разрешенные домены для CORS
# Пример: https://ya.ru,https://google.com
CORS_ALLOWED_ORIGINS=

#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION

# Ключ для верификации токена reCAPTCHA_site_key
RECAPTCHA_SECRET=

# Секрет для аксес токена, например: "SomeVeryHardSecret!#$".
# Должен быть такой же как в user-accounts
ACCESS_TOKEN_SECRET=

# Секрет для рефреш токена, например: "SomeVeryHardRefreshSecret!#$"
# Должен быть такой же как в user-accounts
REFRESH_TOKEN_SECRET=

# Включить или выключить swagger документацию. Разрешенные значения: true, false, 1, 0
IS_SWAGGER_ENABLED=

# Базовый URL для доступа к файлам в хранилище (S3/Yandex Cloud Storage)
# Пример: https://storage.yandexcloud.net/snaptix-files
FILES_STORAGE_BASE_URL=

# Идентификатор клиента OAuth 2.0, выданный Google для аутентификации приложений.
GOOGLE_CLIENT_ID=

# Секрет для Google OAuth, например: "SomeVeryHardSecret!#$"
GOOGLE_CLIENT_SECRET=

# Редирект URL для Google OAuth, например: http://localhost:9000/api/v1/auth/google/redirect
GOOGLE_CALLBACK_URL=