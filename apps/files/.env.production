# Хост и порт для настройки микросервиса в кубернетис
# ДЛЯ ЭТОГО МИКРОСЕРВИСА УКАЗЫВАТЬ ПОРТ ТАКОЙ ЖЕ КАК PORT ВЫШЕ
# https://samurai.it-incubator.io/pc/video-content/watch/cllp3y3qh019ckd13g1ymakvt
MICROSERVICE_FILES_HOST=
MICROSERVICE_FILES_PORT=

# Разрешенные домены для CORS
# Пример: https://ya.ru,https://google.com
CORS_ALLOWED_ORIGINS=

# Пример: postgresql://<username>:<password>@<hostname>:<port>/<database-name>
POSTGRES_FILES_URL=

# Пример: amqp://username:password@localhost:5672
RABBITMQ_URI=

# Настройки S3. Получить в консоли провайдера. Провайдер влиет на инициализацию бакета
# Для дев среды - minio. В остальных случаях - other
# Доступные варианты: minio | other
S3_PROVIDER=
# Пример: http://localhost:10100
S3_ENDPOINT=
# Пример: minioadmin
S3_KEY_ID=
# Пример: minioadmin
S3_SECRET_KEY=
# Пример: tmp-snaptix-files
S3_TMP_BUCKET=
# Пример: main-snaptix-files
S3_MAIN_BUCKET=
# Пример: us-east-1
S3_REGION=
