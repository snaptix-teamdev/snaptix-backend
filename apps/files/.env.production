# Хост и порт для настройки микросервиса в кубернетис
# ДЛЯ ЭТОГО МИКРОСЕРВИСА УКАЗЫВАТЬ ПОРТ ТАКОЙ ЖЕ КАК PORT ВЫШЕ
# https://samurai.it-incubator.io/pc/video-content/watch/cllp3y3qh019ckd13g1ymakvt
MICROSERVICE_FILES_HOST=
MICROSERVICE_FILES_PORT=

# Разрешенные домены для CORS
# Пример: https://ya.ru,https://google.com
CORS_ALLOWED_ORIGINS=

# Пример: postgresql://<username>:<password>@<hostname>:<port>/<database-name>
POSTGRES_FILES_URL=

# Пример: amqp://username:password@localhost:5672
RABBITMQ_URI=

# Настройки S3. Получить в консоли провайдера.
# Пример: https://storage.yandexcloud.net
S3_ENDPOINT=
# Пример: YCAJEmNTX9nm7
S3_KEY_ID=
# Пример: YCAJEmNTX9nm7YCAJEmNTX9nm7
S3_SECRET_KEY=
# Бакет для приватных временных файлов. Пример: tmp-snaptix-files
S3_TMP_BUCKET=
# Бакет для публичных файлов файлов. Пример: main-snaptix-files
S3_MAIN_BUCKET=
# Пример: ru-central1
S3_REGION=
