#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION

MICROSERVICE_FILES_PORT=9004
MICROSERVICE_FILES_HOST=0.0.0.0

POSTGRES_FILES_URL=postgresql://postgres:postgres@localhost:10000/files
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# ---- S3 (MinIO — local) ----
S3_PROVIDER=minio
S3_ENDPOINT=http://localhost:10100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_TMP_BUCKET=snaptix-files-tmp
S3_MAIN_BUCKET=snaptix-files
S3_REGION=us-east-1
S3_WEBHOOK_SECRET=change-me-in-production

