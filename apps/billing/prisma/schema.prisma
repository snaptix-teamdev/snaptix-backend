generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Частичные индексы добавляются отдельной SQL-миграцией.
enum BillingPeriod {
  ONE_DAY
  SEVEN_DAYS
  ONE_MONTH
}

enum PlanTier {
  BUSINESS
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PeriodStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PLATEGA
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum Currency {
  USD
}

//тариф
model SubscriptionPlan {
  id               String                @id @default(uuid(7)) @db.Uuid
  tier             PlanTier              @default(BUSINESS)
  billingPeriod    BillingPeriod         @map("billing_period")
  priceCents       Int                   @map("price_cents") @db.Integer
  currency         Currency              @default(USD)

  stripePriceId    String?               @unique @map("stripe_price_id")

  // Изменение цены — новая строка.
  // У старой версии isActive = false.
  isActive          Boolean              @default(true) @map("is_active")

  subscriptions     UserSubscription[]   @relation("PlanSubscriptions")
  nextSubscriptions UserSubscription[]   @relation("NextPlanSubscriptions")
  periods           SubscriptionPeriod[] @relation("PlanPeriods")

  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("subscription_plans")
}

//ПОДПИСКА 
model UserSubscription {
  id          String             @id @default(uuid(7)) @db.Uuid
  userId      String             @map("user_id") @db.Uuid

  // Текущий тариф.
  planId      String             @map("plan_id") @db.Uuid
  plan        SubscriptionPlan   @relation("PlanSubscriptions", fields: [planId], references: [id])

  // Тариф следующего продления.
  nextPlanId  String?            @map("next_plan_id") @db.Uuid
  nextPlan    SubscriptionPlan?  @relation("NextPlanSubscriptions", fields: [nextPlanId], references: [id])
  
  //автопробление true - после УСПЕШНОЙ оплаты 
  status      SubscriptionStatus @default(PENDING)
  autoRenewal Boolean            @default(false) @map("auto_renewal")

  provider    PaymentProvider
  externalSubscriptionId String? @map("external_subscription_id")

  // Границы текущего оплаченного периода.
  currentPeriodStart DateTime?   @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd   DateTime?   @map("current_period_end") @db.Timestamptz()

  // Когда отключили автопродление.
  canceledAt         DateTime?   @map("canceled_at") @db.Timestamptz()

  // Когда подписка перешла в CANCELED или EXPIRED.
  endedAt            DateTime?   @map("ended_at") @db.Timestamptz()

  periods   SubscriptionPeriod[] @relation("SubscriptionPeriods")

  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([provider, externalSubscriptionId])
  @@index([userId])
  @@index([status, currentPeriodEnd])
  @@map("user_subscriptions")
}

//ПЕРИОД 
model SubscriptionPeriod {
  id             String           @id @default(uuid(7)) @db.Uuid

  subscriptionId String           @map("subscription_id") @db.Uuid
  subscription   UserSubscription @relation( "SubscriptionPeriods", fields: [subscriptionId], references: [id])

  // Тариф конкретного периода.
  planId         String           @map("plan_id") @db.Uuid
  plan           SubscriptionPlan @relation("PlanPeriods", fields: [planId], references: [id])

  periodStart    DateTime?        @map("period_start") @db.Timestamptz()
  periodEnd      DateTime?        @map("period_end") @db.Timestamptz()

  // Снимок стоимости периода.
  amountCents    Int              @map("amount_cents") @db.Integer
  currency       Currency         @default(USD)

  status         PeriodStatus     @default(PENDING)
  paidAt         DateTime?        @map("paid_at") @db.Timestamptz()

  // Попытки оплаты периода.
  payments       Payment[]        @relation("PeriodPayments")

  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([subscriptionId, periodStart])
  @@map("subscription_periods")
}

//ПЛАТЁЖ 
model Payment {
  id                String             @id @default(uuid(7)) @db.Uuid
  userId            String             @map("user_id") @db.Uuid

  periodId          String             @map("period_id") @db.Uuid
  period            SubscriptionPeriod @relation("PeriodPayments", fields: [periodId], references: [id])

  paymentProvider   PaymentProvider    @map("payment_provider")
  externalPaymentId String?            @map("external_payment_id")

  status            PaymentStatus      @default(PENDING)
  failureReason     String?            @map("failure_reason")

  // Стоимость в USD.
  amountCents       Int                @map("amount_cents") @db.Integer
  currency          Currency           @default(USD)

  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz()
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz()

  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  // КОНВЕРТАЦИЯ 
  // Сумма и валюта оплаты при конвертации.
  // payerAmount   Decimal? @map("payer_amount") @db.Decimal(20, 4)
  // payerCurrency String?  @map("payer_currency") @db.Char(3)

  // // Количество единиц payerCurrency за 1 USD.
  // fxRate    Decimal?  @map("fx_rate") @db.Decimal(20, 10)

  @@unique([paymentProvider, externalPaymentId])
  @@index([userId])
  @@index([periodId])
  @@index([status, expiresAt])
  @@map("payments")
}

//OUTBOX 
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  attempts    Int       @default(0)
  publishedAt DateTime? @map("published_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([aggregateId])
  @@map("outbox_events")
}