    "posts:start": "node dist/apps/posts/main",
    "posts:test": "jest --testPathPattern=apps/posts --passWithNoTests",
    "posts:test:e2e": "jest --config ./apps/posts/test/jest-e2e.json",
    "-------------------------": "",
    "geo:start:dev": "cross-env NODE_ENV=development nest start geo --watch",
    "geo:start:debug": "cross-env NODE_ENV=development nest start geo --debug --watch",
