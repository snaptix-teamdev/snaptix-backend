    "geo:prisma:studio:dev": "pnpm geo:prisma-wrapper:dev \"prisma studio --config=apps/geo/prisma/prisma.config.ts\"",
    "geo:prisma-wrapper:dev": "cross-env NODE_ENV=development ts-node scripts/prisma/prisma-wrapper.ts \"apps/geo\"",
    "geo:prisma:deploy:prod": "prisma migrate deploy --config=apps/geo/prisma/prisma.config.ts",
    "geo:import:prod": "cross-env NODE_ENV=production ts-node scripts/geo/import-geonames.ts",
    "pregeo:start:dev": "pnpm docker:up && pnpm geo:prisma:generate && pnpm geo:prisma:deploy:dev",
    "geo:build": "nest build geo",
