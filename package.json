    "user-accounts:prisma-wrapper:dev": "cross-env NODE_ENV=development ts-node scripts/prisma/prisma-wrapper.ts \"apps/user-accounts\"",
    "user-accounts:prisma:deploy:prod": "prisma migrate deploy --config=apps/user-accounts/prisma/prisma.config.ts",
    "preuser-accounts:start:dev": "pnpm docker:up && pnpm user-accounts:prisma:generate && pnpm user-accounts:prisma:deploy:dev",
