{
  "name": "snaptix-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "gateway:start:dev": "cross-env NODE_ENV=development nest start gateway --watch",
    "gateway:start:debug": "cross-env NODE_ENV=development nest start gateway --debug --watch",
    "gateway:build": "nest build gateway",
    "gateway:start": "node dist/apps/gateway/main",
    "gateway:test": "jest --testPathPattern=apps/gateway --passWithNoTests",
    "gateway:test:e2e": "jest --config ./apps/gateway/test/jest-e2e.json",
    "---------------------": "",
    "user-accounts:start:dev": "cross-env NODE_ENV=development nest start user-accounts --watch",
    "user-accounts:start:debug": "cross-env NODE_ENV=development nest start user-accounts --debug --watch",
    "user-accounts:prisma:generate": "prisma generate --schema=apps/user-accounts/prisma/schema.prisma",
    "user-accounts:prisma:migrate:dev": "pnpm user-accounts:prisma-wrapper:dev \"prisma migrate dev --config=apps/user-accounts/prisma/prisma.config.ts\"",
    "user-accounts:prisma:deploy:dev": "pnpm user-accounts:prisma-wrapper:dev \"prisma migrate deploy --config=apps/user-accounts/prisma/prisma.config.ts\"",
    "user-accounts:prisma:studio:dev": "pnpm user-accounts:prisma-wrapper:dev \"prisma studio --config=apps/user-accounts/prisma/prisma.config.ts\"",
    "user-accounts:prisma-wrapper:dev": "cross-env NODE_ENV=development ts-node scripts/prisma/prisma-wrapper.ts \"apps/user-accounts\"",
    "user-accounts:prisma:deploy:prod": "prisma migrate deploy --config=apps/user-accounts/prisma/prisma.config.ts",
    "preuser-accounts:start:dev": "pnpm docker:up && pnpm user-accounts:prisma:generate && pnpm user-accounts:prisma:deploy:dev",
    "user-accounts:build": "nest build user-accounts",
    "user-accounts:start": "node dist/apps/user-accounts/main",
    "----------------------": "",
    "notifications:start:dev": "cross-env NODE_ENV=development nest start notifications --watch",
    "notifications:start:debug": "cross-env NODE_ENV=development nest start notifications --debug --watch",
    "prenotifications:start:dev": "pnpm docker:up",
    "notifications:build": "nest build notifications",
    "notifications:start": "node dist/apps/notifications/main",
    "notifications:test": "jest --testPathPattern=apps/notifications --passWithNoTests",
    "notifications:test:e2e": "jest --config ./apps/notifications/test/jest-e2e.json",
    "-----------------------": "",
    "docker:up": "docker compose -f docker-compose.yml up -d --wait",
    "docker:stop": "docker compose -f docker-compose.yml stop",
    "docker:down": "docker compose -f docker-compose.yml down -v --remove-orphans",
    "------------------------": "",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/gateway/test/jest-e2e.json",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.0",
    "@nestjs-modules/mailer": "^2.3.4",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.18",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^1.0.3",
    "axios": "^1.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "handlebars": "^4.7.9",
    "nestjs-zod": "^5.3.0",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.3",
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "prisma": "^7.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@snaptix/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@snaptix/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@snaptix/core(|/.*)$": "<rootDir>/libs/core/src/$1"
    }
  }
}
